require import AllCore List.
require import ProtocolTypes CanonicalEncoding ProtocolPrimitives.

(* Named primitive games. This abstract theory introduces no conclusion-shaped
   protocol axiom and is not imported directly by executable validator files. *)
type signature_query = verification_key * signature_message.

module type SIGNING_ORACLE = {
  proc sign(
    vk : verification_key,
    message : signature_message
  ) : signature
}.

module SigningOracle(S : SIGNATURE_SCHEME) : SIGNING_ORACLE = {
  var queries : signature_query list

  proc init() : unit = {
    queries <- [];
  }

  proc sign(
    vk : verification_key,
    message : signature_message
  ) : signature = {
    var sig : signature;
    sig <@ S.sign(vk, message);
    queries <- rcons queries (vk, message);
    return sig;
  }
}.

module type EUFCMA_ADVERSARY(O : SIGNING_ORACLE) = {
  proc forge() : verification_key * signature_message * signature
}.

module EUFCMAGame(
  A : EUFCMA_ADVERSARY,
  S : SIGNATURE_SCHEME
) = {
  module O = SigningOracle(S)
  module A = A(O)

  proc main() : bool = {
    var vk : verification_key;
    var message : signature_message;
    var sig : signature;
    var valid : bool;

    O.init();
    (vk, message, sig) <@ A.forge();
    valid <@ S.verify(vk, message, sig.`sig_bytes);

    return
         valid
      /\ sig.`sig_verification_key = vk
      /\ ! mem O.queries (vk, message);
  }
}.

(* Node identity hashes the complete production transcript together with the
   operation signature.  The collision game therefore logs [node_material],
   not only the transcript component. *)
type node_hash_query = node_material * node_id.
type node_collision = node_material * node_material.

op find_collision_with
    (material : node_material)
    (digest : node_id)
    (queries : node_hash_query list) : node_material option =
  with queries = [] => None
  with queries = query :: rest =>
    if query.`2 = digest /\ query.`1 <> material
    then Some query.`1
    else find_collision_with material digest rest.

op find_node_collision_pair
    (queries : node_hash_query list) : node_collision option =
  with queries = [] => None
  with queries = query :: rest =>
    let other = find_collision_with query.`1 query.`2 rest in
    if other = None
    then find_node_collision_pair rest
    else Some (query.`1, oget other).

module type LOGGED_NODE_HASH_ORACLE = {
  proc hash(material : node_material) : node_id
  proc get_queries() : node_hash_query list
}.

module LoggedNodeHash(H : NODE_HASH) : LOGGED_NODE_HASH_ORACLE = {
  var queries : node_hash_query list

  proc init() : unit = {
    queries <- [];
  }

  proc hash(material : node_material) : node_id = {
    var digest : node_id;
    digest <@ H.hash(material);
    queries <- rcons queries (material, digest);
    return digest;
  }

  proc get_queries() : node_hash_query list = {
    return queries;
  }
}.

module type NODE_COLLISION_ADVERSARY(O : LOGGED_NODE_HASH_ORACLE) = {
  proc collide(initial_state : protocol_state) : node_collision
}.

module NodeCollisionGame(
  A : NODE_COLLISION_ADVERSARY,
  H : NODE_HASH
) = {
  module O = LoggedNodeHash(H)
  module A = A(O)

  proc main(initial_state : protocol_state) : bool = {
    var pair : node_collision;
    var queries : node_hash_query list;
    var found : node_collision option;

    O.init();
    pair <@ A.collide(initial_state);
    queries <@ O.get_queries();
    found <- find_node_collision_pair queries;

    return found <> None /\ pair = oget found;
  }
}.

(* Retained transcript-only game for compatibility with the initial executable
   skeleton.  Deliverable A reductions use [NodeCollisionGame]. *)
module type COLLISION_ADVERSARY = {
  proc collide() : operation_transcript * operation_transcript
}.

module TranscriptCollisionGame(
  A : COLLISION_ADVERSARY,
  H : TRANSCRIPT_HASH
) = {
  proc main() : bool = {
    var t1 : operation_transcript;
    var t2 : operation_transcript;
    var h1 : node_id;
    var h2 : node_id;

    (t1, t2) <@ A.collide();
    h1 <@ H.hash(t1);
    h2 <@ H.hash(t2);

    return t1 <> t2 /\ h1 = h2;
  }
}.
