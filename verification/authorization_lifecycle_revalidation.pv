(*
  Revalidates the explicit membership/capability lifecycle boundary.

  Five independent experiments avoid deriving a verdict from a shared branch:

  1. Membership-only removal followed by same-identity rejoin validates the
     still-live old role credential. The revival canary must be reachable.
  2. Coupled capability revocation validates the old credential against the
     post-revocation context. The old-credential canary must remain secret.
  3. A newly granted post-revocation credential must be accepted, proving the
     corrected coupled path is reachable rather than vacuously secure.
  4. A fresh member incarnation validates the old identity credential against
     the new identity. The old-credential canary must remain secret.
  5. A credential granted to the fresh incarnation must be accepted, proving
     that corrected path is reachable rather than vacuously secure.

  The private experiment channels are test-fixture wiring, not a security
  boundary. The role credential constructor and verifier model authenticated
  role assertions exactly as in the existing symbolic authorization model.
  Signature/credential unforgeability remains a computational assumption.
*)

free network : channel.
free removalOnlyInput : channel [private].
free coupledOldInput : channel [private].
free coupledFreshInput : channel [private].
free freshIncarnationOldInput : channel [private].
free freshIncarnationFreshInput : channel [private].

type member.
type capability.
type contextid.
type incarnation.
type roleassertion.
type checkresult.

free alice : member.
free aliceFreshIncarnation : member.
free manageMembers : capability.
free preRemovalContext : contextid.
free postCoupledRemovalContext : contextid.
free oldIncarnation : incarnation.
free newIncarnation : incarnation.

const ok : checkresult.

free removalOnlyRevivalCanary : bitstring [private].
free coupledOldCredentialCanary : bitstring [private].
free coupledHonestCanary : bitstring [private].
free freshIncarnationOldCredentialCanary : bitstring [private].
free freshIncarnationHonestCanary : bitstring [private].

fun issueRole(member, capability, contextid, incarnation) : roleassertion [private].
fun verifyRole(roleassertion, member, capability, contextid, incarnation) : checkresult
reduc forall author : member, required : capability,
             context : contextid, identityIncarnation : incarnation;
  verifyRole(
    issueRole(author, required, context, identityIncarnation),
    author, required, context, identityIncarnation) = ok.

event HistoricalRoleGranted(member, capability, contextid, incarnation).
event RoleRevoked(member, capability, contextid, incarnation).
event CoupledRoleGranted(member, capability, contextid, incarnation).
event FreshIncarnationRoleGranted(member, capability, contextid, incarnation).
event RemovalOnlyAcceptedOldCredential(member, capability, contextid, incarnation).
event CoupledAccepted(member, capability, contextid, incarnation).
event FreshIncarnationAccepted(member, capability, contextid, incarnation).

query author : member, required : capability,
      context : contextid, identityIncarnation : incarnation;
  event(CoupledAccepted(author, required, context, identityIncarnation)) ==>
  event(CoupledRoleGranted(author, required, context, identityIncarnation)).

query author : member, required : capability,
      context : contextid, identityIncarnation : incarnation;
  event(FreshIncarnationAccepted(
    author, required, context, identityIncarnation)) ==>
  event(FreshIncarnationRoleGranted(
    author, required, context, identityIncarnation)).

query attacker(removalOnlyRevivalCanary).
query attacker(coupledOldCredentialCanary).
query attacker(coupledHonestCanary).
query attacker(freshIncarnationOldCredentialCanary).
query attacker(freshIncarnationHonestCanary).

let Issuer =
  event HistoricalRoleGranted(
    alice, manageMembers, preRemovalContext, oldIncarnation);
  event RoleRevoked(
    alice, manageMembers, postCoupledRemovalContext, oldIncarnation);
  event CoupledRoleGranted(
    alice, manageMembers, postCoupledRemovalContext, oldIncarnation);
  event FreshIncarnationRoleGranted(
    aliceFreshIncarnation, manageMembers,
    postCoupledRemovalContext, newIncarnation);

  out(removalOnlyInput,
    issueRole(alice, manageMembers, preRemovalContext, oldIncarnation));
  out(coupledOldInput,
    issueRole(alice, manageMembers, preRemovalContext, oldIncarnation));
  out(coupledFreshInput,
    issueRole(alice, manageMembers, postCoupledRemovalContext, oldIncarnation));
  out(freshIncarnationOldInput,
    issueRole(alice, manageMembers, preRemovalContext, oldIncarnation));
  out(freshIncarnationFreshInput,
    issueRole(
      aliceFreshIncarnation, manageMembers,
      postCoupledRemovalContext, newIncarnation));
  0.

let RemovalOnlyValidator =
  in(removalOnlyInput, roleCredential : roleassertion);
  let result = verifyRole(
    roleCredential, alice, manageMembers,
    preRemovalContext, oldIncarnation) in
  if result = ok then
    event RemovalOnlyAcceptedOldCredential(
      alice, manageMembers, preRemovalContext, oldIncarnation);
    out(network, removalOnlyRevivalCanary)
  else 0.

let CoupledOldCredentialValidator =
  in(coupledOldInput, roleCredential : roleassertion);
  let result = verifyRole(
    roleCredential, alice, manageMembers,
    postCoupledRemovalContext, oldIncarnation) in
  if result = ok then
    out(network, coupledOldCredentialCanary)
  else 0.

let CoupledFreshCredentialValidator =
  in(coupledFreshInput, roleCredential : roleassertion);
  let result = verifyRole(
    roleCredential, alice, manageMembers,
    postCoupledRemovalContext, oldIncarnation) in
  if result = ok then
    event CoupledAccepted(
      alice, manageMembers, postCoupledRemovalContext, oldIncarnation);
    out(network, coupledHonestCanary)
  else 0.

let FreshIncarnationOldCredentialValidator =
  in(freshIncarnationOldInput, roleCredential : roleassertion);
  let result = verifyRole(
    roleCredential, aliceFreshIncarnation, manageMembers,
    postCoupledRemovalContext, newIncarnation) in
  if result = ok then
    out(network, freshIncarnationOldCredentialCanary)
  else 0.

let FreshIncarnationFreshCredentialValidator =
  in(freshIncarnationFreshInput, roleCredential : roleassertion);
  let result = verifyRole(
    roleCredential, aliceFreshIncarnation, manageMembers,
    postCoupledRemovalContext, newIncarnation) in
  if result = ok then
    event FreshIncarnationAccepted(
      aliceFreshIncarnation, manageMembers,
      postCoupledRemovalContext, newIncarnation);
    out(network, freshIncarnationHonestCanary)
  else 0.

process
  Issuer
  | RemovalOnlyValidator
  | CoupledOldCredentialValidator
  | CoupledFreshCredentialValidator
  | FreshIncarnationOldCredentialValidator
  | FreshIncarnationFreshCredentialValidator
